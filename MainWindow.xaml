<Window x:Class="ValheimServerLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valheim Server Launcher" Width="1000" Height="680"
        MinWidth="920" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
  <Grid Margin="16,16,16,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button x:Name="StartButton" Content="安装" MinWidth="70" Height="32" Click="StartClick" Background="{StaticResource StartBrush}"/>
        <Button x:Name="ImportButton" Content="导入" Height="32" Click="ImportClick" Visibility="Visible"/>
        <Button x:Name="RestartButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="40" Height="32" Padding="0" Click="RestartClick" ToolTip="重启服务器"/>
        <Button x:Name="InstallButton" Content="检查更新" Height="32" Click="InstallClick"/>
        <Button x:Name="ValidateButton" Content="校验文件" Height="32" Click="ValidateClick"/>
        <Button x:Name="ForceStopButton" Content="强制停止" Height="32" Click="ForceStopClick" Visibility="Collapsed" Background="{StaticResource DangerBrush}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button x:Name="ServerSettingsButton" Content="服务器设置" Height="32" Click="ServerSettingsClick"/>
        <Button x:Name="ModsButton" Content="模组" Height="32" Click="ModsClick"/>
        <Button x:Name="ServerDirectoryButton" Content="服务器目录" Height="32" Click="ServerDirectoryClick"/>
        <Button x:Name="CommandButton" Content="命令" Height="32" Click="CommandClick"/>
        <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="38" Height="32" Padding="0" Click="LauncherSettingsClick" ToolTip="启动器设置"/>
      </StackPanel>
    </DockPanel>

    <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
        <TextBlock Text="状态" Style="{StaticResource Caption}" Margin="0,0,6,0"/>
        <TextBlock x:Name="StatusText" Text="已停止" Style="{StaticResource StatValue}" Margin="0,0,22,0"/>
        <TextBlock Text="更新" Style="{StaticResource Caption}" Margin="0,0,6,0"/>
        <TextBlock x:Name="UpdateStatusText" Text="未检查" Style="{StaticResource StatValue}" Margin="0,0,18,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
        <TextBlock Text="公网 IP" Style="{StaticResource Caption}" Margin="0,0,6,0"/>
        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource FieldBorderBrush}"
                BorderThickness="1" CornerRadius="2" Width="210" Height="28" Margin="0,0,4,0">
          <TextBox x:Name="PublicIpBox" Text="-" IsReadOnly="True"
                   TextWrapping="NoWrap" HorizontalScrollBarVisibility="Disabled"
                   Background="Transparent" BorderThickness="0" Padding="8,4"
                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                   HorizontalContentAlignment="Left"/>
        </Border>
        <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Width="32" Height="28"
                Padding="0" Click="CopyPublicIpClick" ToolTip="复制公网 IP:端口"/>
        <Button Content="&#xE7B3;" FontFamily="Segoe MDL2 Assets" Width="32" Height="28"
                Padding="0" Click="ToggleIpClick" ToolTip="显示/隐藏公网 IP"/>
      </StackPanel>
    </DockPanel>

    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <DockPanel Margin="0,0,0,8">
        <ToggleButton x:Name="CompactToggle" DockPanel.Dock="Left" Style="{StaticResource ToggleSwitch}"
                      Margin="2,0,8,0" Click="CompactClick" ToolTip="紧凑模式"/>
        <TextBlock Text="紧凑模式" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Border Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid x:Name="SettingsArea">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Section}">
          <StackPanel>
            <TextBlock Text="重新启动" Style="{StaticResource PanelHeader}"/>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="ScheduledRestartBox" Content="定时重新启动"/>
              <Button x:Name="RestartTimesBox" Content="05:00, 17:00" Click="EditRestartTimesClick" Margin="8,0,0,5" Padding="8,3"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="最短运行时间" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              <TextBox x:Name="RestartMinimumHoursBox" Style="{StaticResource NumericField}" Width="42" Text="2" Margin="8,0,5,0"/>
              <TextBlock Text="小时" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="RestartAnnouncementBox" Content="重启公告"/>
              <TextBox x:Name="AnnouncementFirstBox" Style="{StaticResource NumericField}" Width="42" Text="15" Margin="6,0,3,0" MaxLength="3"/>
              <TextBox x:Name="AnnouncementSecondBox" Style="{StaticResource NumericField}" Width="42" Text="5" Margin="3,0,3,0" MaxLength="3"/>
              <TextBox x:Name="AnnouncementThirdBox" Style="{StaticResource NumericField}" Width="42" Text="1" Margin="3,0,3,0" MaxLength="3"/>
              <TextBlock Text="分钟" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="ValidateOnRestartBox" Content="重启时校验文件"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Section}">
          <StackPanel>
            <TextBlock Text="备份" Style="{StaticResource PanelHeader}"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="备份时机" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <CheckBox x:Name="BackupStartupBox" Content="启动时"/>
              <CheckBox x:Name="BackupShutdownBox" Content="关闭时" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="ScheduledBackupBox" Content="定时"/>
              <Button x:Name="BackupTimesBox" Content="04:00" Click="EditBackupTimesClick" Margin="8,0,0,5" Padding="8,3"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="保留" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              <TextBox x:Name="RetentionBox" Style="{StaticResource NumericField}" Width="42" Margin="8,0,5,0"/>
              <TextBlock Text="天" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </StackPanel>
            <WrapPanel>
              <TextBlock Text="下次备份" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="NextBackupText" Text="-" Style="{StaticResource StatValue}" Margin="0,0,10,0"/>
              <Button Content="立即备份" Click="BackupClick"/>
            </WrapPanel>
            <WrapPanel>
              <TextBlock Text="备份位置" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <Button x:Name="BackupLocationButton" Content="默认" Click="OpenBackupsClick"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Section}" Margin="0">
          <StackPanel>
            <TextBlock Text="杂项" Style="{StaticResource PanelHeader}"/>
            <CheckBox x:Name="PinVersionBox" Content="固定服务器版本"/>
            <CheckBox x:Name="AutoUpdateBox" Content="自动更新"/>
            <CheckBox x:Name="UpdateOnStartBox" Content="启动/重启时更新" Margin="16,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,6">
              <TextBlock Text="检查更新间隔" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              <TextBox x:Name="UpdateMinutesBox" Style="{StaticResource NumericField}" Width="48" Text="30" Margin="8,0,5,0" MaxLength="4"/>
              <TextBlock Text="分钟" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="RestartOnCrashBox" Content="崩溃自动重启"/>
            <CheckBox x:Name="HealthCheckBox" Content="健康检查"/>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
              <TextBlock Text="检查间隔" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              <TextBox x:Name="HealthSecondsBox" Style="{StaticResource NumericField}" Width="42" Text="10" Margin="8,0,5,0" MaxLength="3"/>
              <TextBlock Text="秒" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="False">
        <TabControl x:Name="LogTabs" Height="34" BorderThickness="0" SelectionChanged="LogTabChanged">
          <TabItem Header="常规"/><TabItem Header="启动器"/><TabItem Header="服务器日志"/><TabItem Header="玩家"/><TabItem Header="SteamCMD"/>
        </TabControl>
        <Button DockPanel.Dock="Right" Content="服务器命令" Click="CommandClick"/>
        <Button DockPanel.Dock="Right" Content="跳转到最新" Click="JumpLatestClick"/>
        <Button DockPanel.Dock="Right" Content="清空日志" Click="ClearLogClick"/>
        <TextBox x:Name="LogFilterBox" DockPanel.Dock="Right" Width="180" Height="28" Margin="8,0,0,0" Padding="6,2" TextChanged="LogFilterChanged" ToolTip="筛选日志，按 Esc 清除"/>
      </DockPanel>
      <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" Margin="0,0,0,8"
               Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource SunkenBrush}"
               Foreground="#C8C8C8" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               PreviewKeyDown="LogPreviewKeyDown"/>
    </Grid>

    <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,5,0,0">
      <DockPanel>
        <TextBlock Text="版本" Style="{StaticResource Caption}"/><TextBlock x:Name="VersionText" Text="-" Style="{StaticResource StatValue}" Margin="5,0,18,0"/>
        <TextBlock Text="FPS" Style="{StaticResource Caption}"/><TextBlock x:Name="FpsText" Text="-" Style="{StaticResource StatValue}" Margin="5,0,18,0"/>
        <TextBlock Text="CPU" Style="{StaticResource Caption}"/><TextBlock x:Name="CpuText" Text="-" Style="{StaticResource StatValue}" Margin="5,0,18,0"/>
        <TextBlock Text="内存" Style="{StaticResource Caption}"/><TextBlock x:Name="MemoryText" Text="-" Style="{StaticResource StatValue}" Margin="5,0,18,0"/>
        <TextBlock Text="玩家" Style="{StaticResource Caption}"/><TextBlock x:Name="PlayersText" Text="-" Style="{StaticResource StatValue}" Margin="5,0,18,0"/>
        <TextBlock Text="运行时间" Style="{StaticResource Caption}"/><TextBlock x:Name="UptimeText" Text="-" Style="{StaticResource StatValue}" Margin="5,0,18,0"/>
        <TextBlock Text="下次重启" Style="{StaticResource Caption}"/><TextBlock x:Name="NextRestartText" Text="-" Style="{StaticResource StatValue}" Margin="5,0,0,0"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
