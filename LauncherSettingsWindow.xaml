<Window x:Class="ValheimServerLauncher.LauncherSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动器设置" Width="430" Height="470" MinWidth="390" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}">
  <Grid Margin="22,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="语言" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Margin="0,0,18,0"/>
      <ComboBox x:Name="LanguageBox" Grid.Column="1" Height="30">
        <ComboBoxItem Tag="" Content="跟随系统"/>
        <ComboBoxItem Tag="zh" Content="简体中文"/>
        <ComboBoxItem Tag="en" Content="English"/>
      </ComboBox>
    </Grid>
    <StackPanel Grid.Row="1">
      <CheckBox x:Name="AutoReconnectBox" Content="启动器启动时自动重新连接到运行中的服务器，无需询问"/>
      <CheckBox x:Name="StartAtLoginBox" Content="在 Windows 登录时打开启动器并启动服务器"/>
      <CheckBox x:Name="HideSteamCmdBox" Content="隐藏 SteamCMD 窗口"/>
      <CheckBox x:Name="LogHealthStatsBox" Content="记录服务器状态"/>
      <CheckBox x:Name="WarnUnknownServersBox" Content="不再询问是否终止未知服务器"/>
      <CheckBox x:Name="ClearLogsBox" Content="手动启动和重新启动服务器时清空日志"/>
      <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>
      <TextBlock Text="开源许可证" Foreground="{StaticResource AccentBrush}" Cursor="Hand"/>
      <TextBlock Text="v1.3.0 - © 2026 Syl S. - GPLv3" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" IsCancel="True"/>
      <Button Content="保存" IsDefault="True" Click="SaveClick" Background="{StaticResource AccentBrush}"/>
    </StackPanel>
  </Grid>
</Window>
